# Copy to services/managed-api/.env for local orchestration only.
# Never commit the populated file. Production secrets belong in your host's secret manager.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
MANAGED_API_ORIGIN=https://api.your-owned-domain.example
DATABASE_URL=postgresql://SERVICE_USER:REPLACE_PASSWORD@YOUR_POSTGRES_HOST:5432/opentypeless?sslmode=require
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=10
RUN_MIGRATIONS_ON_START=false
TRUST_PROXY_HOPS=1

# Generate separately; never reuse either value:
#   openssl rand -base64 48              (BETTER_AUTH_SECRET)
#   openssl rand -base64 32              (BACKUP_ENCRYPTION_KEY; exactly 32 decoded bytes)
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_EXACT_32_BYTE_BASE64_VALUE
BACKUP_ENCRYPTION_KEY_ID=primary

CORS_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost
DESKTOP_DEEP_LINK_SCHEME=yourproduct

ELEVENLABS_API_KEY=REPLACE_WITH_ELEVENLABS_SERVER_KEY
ELEVENLABS_STT_MODEL=scribe_v2
GEMINI_API_KEY=REPLACE_WITH_GEMINI_SERVER_KEY
GEMINI_MODEL=gemini-2.5-flash

STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_MONTHLY_PRICE_ID=REPLACE_WITH_STRIPE_MONTHLY_PRICE_ID
# Optional; omit the variable entirely when no lifetime offer is sold.
# STRIPE_LIFETIME_STARTER_PRICE_ID=REPLACE_WITH_STRIPE_ONE_TIME_PRICE_ID
PRO_MONTHLY_CLOUD_WORDS=100000
LIFETIME_CLOUD_WORDS=25000

RESEND_API_KEY=REPLACE_WITH_RESEND_SERVER_KEY
MAIL_FROM=OpenTypeless <support@your-owned-domain.example>
PUBLIC_WEBSITE_URL=https://www.your-owned-domain.example

# Optional OAuth providers; set each provider as a complete client-id/client-secret pair.
# GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
# GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
# GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET

LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000
