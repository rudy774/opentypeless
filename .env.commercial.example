# Copy to .env.commercial (ignored) and replace every placeholder. This file
# contains public client identity only. Never add provider, OAuth, deployment,
# billing, or signing private keys.
COMMERCIAL_BUILD=true

COMMERCIAL_API_ORIGIN=https://api.your-domain.example
VITE_MANAGED_API_BASE_URL=https://api.your-domain.example
OPENTYPELESS_MANAGED_API_BASE_URL=https://api.your-domain.example

COMMERCIAL_WEBSITE_URL=https://www.your-domain.example
COMMERCIAL_REPOSITORY_URL=https://github.com/rudy774/your-repository
COMMERCIAL_SUPPORT_URL=https://support.your-domain.example
COMMERCIAL_PRIVACY_URL=https://www.your-domain.example/privacy
COMMERCIAL_TERMS_URL=https://www.your-domain.example/terms

COMMERCIAL_PRODUCT_NAME=Your Product
VITE_APP_DEEP_LINK_SCHEME=yourproduct
COMMERCIAL_APP_IDENTIFIER=com.yourcompany.yourproduct
COMMERCIAL_DEEP_LINK_SCHEME=yourproduct
COMMERCIAL_TAURI_CONFIG_PATH=src-tauri/tauri.commercial.generated.json

# Auto-update remains intentionally disabled. Add an owned feed and public
# verification key only in a future, separately reviewed release increment.
# Never place TAURI_SIGNING_PRIVATE_KEY or any other private key here.
