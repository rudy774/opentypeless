{
  "name": "opentypeless",
  "private": true,
  "version": "0.1.42",
  "type": "module",
  "description": "AI-powered speech-to-text and text polishing desktop app",
  "keywords": [
    "speech-to-text",
    "stt",
    "llm",
    "tauri",
    "desktop",
    "voice-input"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rudy774/opentypeless"
  },
  "homepage": "https://github.com/rudy774/opentypeless",
  "bugs": {
    "url": "https://github.com/rudy774/opentypeless/issues"
  },
  "author": "OpenTypeless Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "commercial:check": "node scripts/check-commercial-release.mjs",
    "commercial:check:test": "node --test scripts/commercial-release-check.test.mjs",
    "release:version:test": "node --test scripts/sync-release-version.test.mjs",
    "service:contract:check": "node scripts/check-managed-service-contract.mjs",
    "service:contract:test": "node --test scripts/check-managed-service-contract.test.mjs",
    "service:build": "tsc -p services/managed-api/tsconfig.json",
    "service:test": "vitest run --config services/managed-api/vitest.config.ts",
    "service:lint": "eslint services/managed-api/src",
    "service:format": "prettier --write services/managed-api/src services/managed-api/*.json services/managed-api/*.md",
    "service:format:check": "prettier --check services/managed-api/src services/managed-api/*.json services/managed-api/*.md",
    "service:verify": "npm run service:build && npm run service:test && npm run service:contract:check && npm run service:contract:test && npm run service:lint && npm run service:format:check",
    "service:migrate": "node services/managed-api/build/migrate.js",
    "service:start": "node services/managed-api/build/server.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2",
    "@tauri-apps/plugin-deep-link": "^2.2",
    "@tauri-apps/plugin-global-shortcut": "^2.2",
    "@tauri-apps/plugin-opener": "^2.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.6.27",
    "express": "5.2.1",
    "framer-motion": "^11.18",
    "i18next": "^24.2",
    "lucide-react": "^0.460",
    "multer": "2.2.0",
    "pg": "8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4",
    "stripe": "22.5.0",
    "zod": "4.4.3",
    "zustand": "^5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^6.6",
    "@testing-library/react": "^16.3",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.21.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.18",
    "eslint-plugin-react-hooks": "^5.2",
    "eslint-plugin-react-refresh": "^0.4",
    "jsdom": "^25.0",
    "nanoid": "5.1.16",
    "postcss": "8.5.26",
    "prettier": "^3.5",
    "supertest": "7.2.2",
    "tailwindcss": "^4.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.22",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
